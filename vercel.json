{
  "framework": null,
  "buildCommand": "",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "byteform.org"
        }
      ],
      "destination": "https://www.byteform.org/$1",
      "permanent": true
    },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/assets/for dark bg.png", "destination": "/assets/byteform-logo-dark.png", "permanent": true },
    { "source": "/assets/for%20dark%20bg.png", "destination": "/assets/byteform-logo-dark.png", "permanent": true },
    { "source": "/assets/for light bg.png", "destination": "/assets/byteform-logo-light.png", "permanent": true },
    { "source": "/assets/for%20light%20bg.png", "destination": "/assets/byteform-logo-light.png", "permanent": true },
    { "source": "/assets/website icon.png", "destination": "/assets/byteform-icon.png", "permanent": true },
    { "source": "/assets/website%20icon.png", "destination": "/assets/byteform-icon.png", "permanent": true },
    { "source": "/background video.mp4", "destination": "/assets/hero-bg.mp4", "permanent": true },
    { "source": "/background%20video.mp4", "destination": "/assets/hero-bg.mp4", "permanent": true },
    { "source": "/capabilities.html", "destination": "/services", "permanent": true },
    { "source": "/capabilities", "destination": "/services", "permanent": true },
    { "source": "/collective.html", "destination": "/team", "permanent": true },
    { "source": "/collective", "destination": "/team", "permanent": true },
    { "source": "/protocol.html", "destination": "/process", "permanent": true },
    { "source": "/protocol", "destination": "/process", "permanent": true },
    { "source": "/services.html", "destination": "/services", "permanent": true },
    { "source": "/team.html", "destination": "/team", "permanent": true },
    { "source": "/process.html", "destination": "/process", "permanent": true },
    { "source": "/reviews.html", "destination": "/reviews", "permanent": true },
    { "source": "/careers.html", "destination": "/careers", "permanent": true },
    { "source": "/contact.html", "destination": "/contact", "permanent": true },
    { "source": "/estimator.html", "destination": "/", "permanent": true },
    { "source": "/estimator", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.web3forms.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com;"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/css; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon.*|apple-touch-icon.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
