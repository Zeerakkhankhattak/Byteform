rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Applications collection for job submissions
    match /applications/{applicationId} {
      
      // 1. PUBLIC APPLICANTS:
      // Can submit new applications with required fields
      allow create: if request.resource.data.name is string
                    && request.resource.data.email is string;

      // Allow candidate submission / status updates
      allow update: if request.auth != null 
                    || (request.resource.data.name is string && request.resource.data.email is string)
                    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);

      // 2. ADMINISTRATOR ACCESS:
      // Allows reading submitted applications in both Authenticated and Demo / API modes
      allow read: if true;

      // Deletion is restricted to authenticated administrators
      allow delete: if request.auth != null;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

