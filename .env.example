# ==============================================================================
# BYTEFORM DIGITAL STUDIO · ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and provide your production / development secrets.
# NEVER commit .env to public version control!
# ==============================================================================

# 1. Supabase Project Configuration
# Obtain from your Supabase Dashboard: Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Secret Service Role Key: used strictly on backend/serverless functions
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Admin Portal Security
# Strong password used to access /admin/certificates
ADMIN_PASSWORD=your_secure_admin_passphrase_here
# Optional 32+ character secret used to sign session cookies (defaults to secure hash if not set)
ADMIN_JWT_SECRET=your_random_32_character_session_signing_secret_here

# 3. Certificate Configuration
# Prefix for auto-generated certificate IDs (e.g. BF-INT-2026-X7K92P)
CERT_ID_PREFIX=BF-INT-

# 4. Canonical Site URL (Used for QR code verification URLs)
# In development: http://localhost:3000
# In production: https://www.byteform.org
SITE_URL=https://www.byteform.org
